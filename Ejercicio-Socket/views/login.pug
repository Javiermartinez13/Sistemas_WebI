extends layout

block content
  main.tarjeta.login
    h1 Chat
    p.subtitulo Inicia sesión para entrar
    if error
      p.error= error
    form(method='POST' action='/login')
      label(for='usuario') Usuario
      input#usuario(type='text' name='usuario' value=usuario required autofocus)
      label(for='password') Contraseña
      input#password(type='password' name='password' required)
      button.btn(type='submit') Entrar
